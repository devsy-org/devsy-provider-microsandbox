{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "helpers:pinGitHubActionDigests"],
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "dependencyDashboard": false,
  "prConcurrentLimit": 1,
  "platformAutomerge": true,
  "postUpdateOptions": ["gomodTidy"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "prek hook repositories in prek.toml (Renovate has no prek manager yet)",
      "managerFilePatterns": ["/(^|/)prek\\.toml$/"],
      "matchStrings": [
        "repo = \"https://github\\.com/(?<depName>[^\"]+)\"\\s+rev = \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "prPriority": 10
    },
    {
      "matchManagers": ["github-actions"],
      "automerge": true,
      "prPriority": 5
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["prek.toml"],
      "automerge": true,
      "prPriority": 4
    },
    {
      "matchManagers": ["mise"],
      "matchDatasources": ["github-tags"],
      "matchPackageNames": ["golang/go"],
      "matchFileNames": ["mise.toml"],
      "allowedVersions": ">=1.26.0 <1.27.0",
      "automerge": false,
      "description": "keep the mise Go toolchain on the Go 1.26 major line"
    },
    {
      "matchManagers": ["gomod"],
      "automerge": true,
      "prPriority": 3
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "prPriority": -1
    }
  ]
}
